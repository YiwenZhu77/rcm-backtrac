#!/bin/bash
#PBS -N sina_mage
#PBS -A YOUR_PROJECT
#PBS -q YOUR_QUEUE
#PBS -l select=1:ncpus=1:mem=32GB
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /path/to/pilot-data/sina_mage.log

module load conda
conda activate base
cd "$PBS_O_WORKDIR"

echo "Starting Sina (adapted) on MAGE data..."
date
python3 -u run_mage.py
echo "STATUS=$?"
date
